# Documentation only: set these in PowerShell or use node --env-file=.env.
# Existing evaluator remains: pnpm start (port 4317).
CHALLENGE_DEMO=true
CHALLENGE_PORT=4320
CHALLENGE_ORIGIN=http://127.0.0.1:4320
CHALLENGE_DATA_DIR=.local/challenge
# Live mode requires all settings below. Never commit real credentials.
# CHALLENGE_ADMIN_PASSWORD=choose-a-long-unique-password
# CHALLENGE_GITHUB_APP_ID=
# CHALLENGE_GITHUB_INSTALLATION_ID=
# CHALLENGE_GITHUB_CLIENT_ID=
# CHALLENGE_GITHUB_CLIENT_SECRET=
# CHALLENGE_GITHUB_PRIVATE_KEY_PATH=C:/secure/location/wine-challenge.private-key.pem
# CHALLENGE_GITHUB_WEBHOOK_SECRET=
